{
  "name": "krynox/captcha-laravel",
  "description": "Krynox Captcha for Laravel — privacy-first, proof-of-work CAPTCHA. Blade component + validation rule.",
  "keywords": ["laravel", "captcha", "krynox", "spam", "proof-of-work", "privacy"],
  "homepage": "https://krynox.net",
  "license": "MIT",
  "authors": [
    { "name": "Krynox", "homepage": "https://krynox.net" }
  ],
  "require": {
    "php": "^8.1",
    "illuminate/support": "^10.0|^11.0|^12.0|^13.0",
    "guzzlehttp/guzzle": "^7.5"
  },
  "require-dev": {
    "orchestra/testbench": "^8.22|^9.0|^10.0|^11.0",
    "phpunit/phpunit": "^10.5|^11.0|^12.0"
  },
  "autoload": {
    "psr-4": {
      "Krynox\\Captcha\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Krynox\\Captcha\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit"
  },
  "extra": {
    "laravel": {
      "providers": [
        "Krynox\\Captcha\\KrynoxServiceProvider"
      ]
    }
  },
  "support": {
    "issues": "https://github.com/krynox-security/plugin-laravel/issues",
    "source": "https://github.com/krynox-security/plugin-laravel",
    "docs": "https://docs.krynox.net"
  },
  "minimum-stability": "stable",
  "prefer-stable": true
}
